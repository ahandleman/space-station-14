    <Compile Include="../../../Content.Tests/Shared/Procedural/StationRegionTests.cs" Link="StationRegionTests.cs" />
    <Compile Include="../../../Content.Tests/Shared/Procedural/StationMaintenanceTests.cs" Link="StationMaintenanceTests.cs" />
    <Compile Include="../../../Content.Tests/Shared/Procedural/StationMaintenanceWidthTests.cs" Link="StationMaintenanceWidthTests.cs" />
    <Compile Include="../../../Content.Tests/Shared/Procedural/StationHierarchyTests.cs" Link="StationHierarchyTests.cs" />
    <Compile Include="../../../Content.Tests/Shared/Procedural/StationDefinitionTests.cs" Link="StationDefinitionTests.cs" />
    <Compile Include="../../../Content.Tests/Shared/Procedural/StationCandidateTests.cs" Link="StationCandidateTests.cs" />
  </ItemGroup>
</Project>
